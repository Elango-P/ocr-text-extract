# Required for AdSense script + ads.txt (from AdSense → Sites / Account information)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Manual display unit slot IDs (AdSense → Ads → By ad unit → data-ad-slot)
NEXT_PUBLIC_ADSENSE_SLOT_DISPLAY=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=

# Optional: Google Search Console / AdSense HTML tag verification content value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Gemini AI OCR (server-only — never expose to the client)
# Prefer GOOGLE_GENERATIVE_AI_API_KEY; GOOGLE_GENERATION_AI_API_KEY is also accepted.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
